# -----------------------------------------------------------------------------
# Nova Nail Studio — ortam değişkenleri (örnek)
# Gerçek değerleri yalnızca .env.local veya Vercel Project Settings’e girin;
# bu dosyayı asla gerçek anahtarlarla commit etmeyin.
# -----------------------------------------------------------------------------

# Üretim ortamında kanonik URL (metadata, OAuth redirect, PWA scope uyumu için önerilir).
# Örnek: https://nova-studio.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Dashboard → Settings → API — Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase — anon / public JWT (eyJ... ile başlar). Middleware, Server ve tarayıcı istemcisi.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_jwt_here

# (İsteğe bağlı) Yeni Supabase "publishable" anahtarı — kodda henüz kullanılmıyor.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sunucu tarafı gizli anahtar — RLS bypass eder; ASLA NEXT_PUBLIC_ yapmayın.
SUPABASE_SECRET_KEY=

# Migration script (npm run supabase:migrate) — Connection string (pooler önerilir).
DATABASE_URL=
